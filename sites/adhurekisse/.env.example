# ==============================================================================
# ADHURE KISSE — environment configuration (placeholders only, never real keys)
# ==============================================================================

# ── Supabase (auth, database, realtime) ──────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"
# Server-only: checked Auth invitations, upload publication and durable cleanup.
# NEVER expose this to the client. Site runbook: ../../docs/ADHUREKISSE-OPERATIONS.md
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# ── Cloudflare R2 (private music storage) ────────────────────────────────────
# R2 dashboard → Manage API tokens (Object Read & Write scope on ONE bucket)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="adhurekisse-audio"
# Keep r2.dev/public custom domains OFF; presigns use the S3 API host only.
# Use exact app origins in bucket CORS; never a wildcard Vercel origin.

# ── Spotify (optional, PKCE — no secret involved) ────────────────────────────
NEXT_PUBLIC_SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI="http://localhost:3000/callback"

# ── Isolated testing reference ONLY — inject into a separate test shell ──────
# Do not uncomment these in live .env.local or live Vercel settings.
# TEST_* are operator/acceptance inputs, not application runtime variables.
# Exact generated-tone/guarded seed/E2E recipe: ../../docs/ADHUREKISSE-OPERATIONS.md
# TEST_TARGET_CONFIRMED="adhurekisse-isolated-test"
# TEST_APP_ORIGIN="https://REPLACE-ISOLATED-TEST-DEPLOYMENT.invalid"
# TEST_SUPABASE_PROJECT_REF="REPLACE_TEST_PROJECT_REF"
# TEST_SUPABASE_URL="https://REPLACE_TEST_PROJECT_REF.supabase.co"
# TEST_SUPABASE_ANON_KEY="REPLACE_TEST_PUBLIC_ANON_KEY"
# TEST_DATABASE_URL="postgresql://TEST_USER:REPLACE_TEST_PASSWORD@TEST_DB_HOST:5432/postgres?sslmode=require"
# TEST_R2_BUCKET_NAME="adhurekisse-acceptance-test"
# TEST_HOST_EMAIL="test-owner@example.invalid"
# TEST_HOST_PASSWORD="REPLACE_TEST_OWNER_PASSWORD"
# TEST_GUEST_EMAIL="test-guest@example.invalid"
# TEST_GUEST_PASSWORD="REPLACE_TEST_GUEST_PASSWORD"
# TEST_THIRD_EMAIL="test-outsider@example.invalid"
# TEST_THIRD_PASSWORD="REPLACE_TEST_OUTSIDER_PASSWORD"
# TEST_TRACK_TITLE="TEST Tone 440Hz 600s"
# TEST_SECOND_TRACK_TITLE="TEST Tone 660Hz 30s"
# Hosted test:e2e consumes E2E_BASE_URL, E2E_SUPABASE_URL, E2E_SUPABASE_ANON_KEY,
# E2E_HOST_EMAIL/PASSWORD, E2E_GUEST_EMAIL/PASSWORD, E2E_THIRD_EMAIL/PASSWORD,
# E2E_TEST_TRACK_TITLE, E2E_SECOND_TRACK_TITLE and E2E_RESTRICTED_TRACK_ID.
# The guarded TEST-only launcher maps those explicitly. Local CI requires the
# QA-owned test:e2e:local script and no hosted credentials; missing scripts fail.
