# ==============================================================================
# ADHURE KISSE — environment configuration (placeholders only, never real keys)
# ==============================================================================

# ── Supabase (auth, database, realtime) ──────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"
# Server-only. Used by API routes for storage bookkeeping after RLS-filtered
# deletes. NEVER expose this to the client. Rotation: see docs/DEPLOYMENT.md
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# ── Cloudflare R2 (private music storage) ────────────────────────────────────
# R2 dashboard → Manage API tokens (Object Read & Write scope on ONE bucket)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="adhurekisse-audio"

# ── Spotify (optional, PKCE — no secret involved) ────────────────────────────
NEXT_PUBLIC_SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI="http://localhost:3000/callback"

# ── E2E testing only (never set in production) ───────────────────────────────
# E2E_BASE_URL, E2E_SUPABASE_URL, E2E_HOST_EMAIL, ...
