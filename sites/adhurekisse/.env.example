# ==============================================================================
# SPOTIFY AUTHENTICATION CONFIGURATION
# ==============================================================================
#
# Adhurekisse uses the Spotify Web Playback SDK with PKCE (Proof Key for Code Exchange).
# This means NO client secret is required or used in the browser.
#
# To enable Spotify playback:
# 1. Go to https://developer.spotify.com/dashboard
# 2. Create an App
# 3. Add your redirect URI (e.g., http://localhost:3000/callback) in Settings
# 4. Copy the Client ID below
#
# YouTube playback is the default and works even if these are empty.

NEXT_PUBLIC_SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI="http://localhost:3000/callback"
